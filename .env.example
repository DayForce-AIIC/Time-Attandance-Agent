DB_PATH=./shiftguard.db
# Set staging/production only after using Supabase Auth and non-local CORS origins.
ENVIRONMENT=development
# Keep demo mode for the synthetic local demo. Set supabase only after configuring
# the Supabase project and creating organization/user_profiles records.
AUTH_MODE=demo
# Restricts this API process to one organization in authenticated workflow mode.
# SUPABASE_URL=https://your-project.supabase.co
# AUTH_ORGANIZATION_ID=00000000-0000-0000-0000-000000000000
# CORS_ORIGINS=http://localhost:5173,https://shiftguard.example.com
# Server-only PostgreSQL connection string (for example, Supabase's transaction pooler).
# Keep unset for the local SQLite demo. Never put this value in frontend environment variables.
# SUPABASE_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?sslmode=require
# Server-only database connection timeout.
POSTGRES_CONNECT_TIMEOUT_SECONDS=5
# Only needed for projects still using the legacy HS256 JWT signing secret.
# SUPABASE_JWT_SECRET=
# Synthetic company API by default. Use http only after agreeing on the vendor contract.
ATTENDANCE_PROVIDER=mock
# ATTENDANCE_API_BASE_URL=https://attendance.example.com
# ATTENDANCE_API_TIMEOUT_SECONDS=10
# Server-only integration credential. Never put this in frontend variables.
# ATTENDANCE_API_TOKEN=
# Webhook identity and signing secret. Create an active public.integrations row first.
# ATTENDANCE_INTEGRATION_ID=00000000-0000-0000-0000-000000000000
# INTEGRATION_WEBHOOK_SECRET=
# INTEGRATION_WEBHOOK_MAX_SKEW_SECONDS=300
# INTEGRATION_WEBHOOK_MAX_BODY_BYTES=65536
ANALYSIS_MAX_ATTEMPTS=4
ANALYSIS_RETRY_BASE_SECONDS=15
ANALYSIS_JOB_LEASE_SECONDS=300
ANALYSIS_WORKER_POLL_SECONDS=2
ANALYSIS_WORKER_HEARTBEAT_SECONDS=30
ANALYSIS_WORKER_HEARTBEAT_TIMEOUT_SECONDS=300
# Per-process limits for expensive or externally exposed POST routes.
RATE_LIMIT_WINDOW_SECONDS=60
ASSISTANT_RATE_LIMIT_PER_WINDOW=20
WEBHOOK_RATE_LIMIT_PER_WINDOW=120
WRITEBACK_RATE_LIMIT_PER_WINDOW=20
# Optional generic JSON alert webhook. Payloads contain safe IDs/error codes only.
# OPS_ALERT_WEBHOOK_URL=
OPS_ALERT_TIMEOUT_SECONDS=3
OPS_ALERT_FAILURE_THRESHOLD=3
OPS_ALERT_WINDOW_SECONDS=300
OPS_ALERT_COOLDOWN_SECONDS=900
DEMO_NOW=2025-03-13T20:00
LLM_PROVIDER=mock
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
LLM_TIMEOUT_SECONDS=60
ENABLE_DEMO_CONTROLS=true
DEFAULT_MANAGER_ID=m-001
MANUAL_MINUTES_PER_EXCEPTION=6
REVIEW_MINUTES_PER_EXCEPTION=1
